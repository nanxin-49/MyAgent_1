# CartCare 环境变量
# docker compose 部署时会自动读取此文件

# ── Anthropic / DeepSeek ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=deepseek-flash
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=cartcare123
# 宿主机端口；若 6379 被系统保留/占用，可改为 6380
REDIS_PORT=6379
# docker compose 内部地址（容器间通信）
REDIS_URL=redis://:cartcare123@redis:6379/0

# ── ChromaDB（情景记忆 + 用户画像）─────────────────────────────────────────────
# docker compose 内部地址（连接独立 ChromaDB 服务）
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# 兼容旧配置项；当前仅通过 HTTP 连接独立 ChromaDB 服务
CHROMA_PERSIST_DIRECTORY=/app/data/chroma

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=

# ── CartCare 兼容配置 ─────────────────────────────────────────────────────────
# 旧 ECHOMIND_* 名称仍作为回退；新部署使用 CARTCARE_*。
CARTCARE_SKILLS_DIR=/app/skills
