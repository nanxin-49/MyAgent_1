{
  "schema": "cartcare.h3_2.recovery_cases",
  "version": 1,
  "cases": [
    {
      "id": "timeout_once",
      "category": "timeout",
      "message": "帮我查订单 ORD-1001",
      "tool": "get_order",
      "args": {"order_id": "ORD-1001"},
      "faults": [{"tool": "get_order", "kind": "timeout", "on_call": 1}],
      "max_retries": 1,
      "success_text": "订单查询完成。",
      "unrecovered_text": "查询已受理。",
      "ask_text": "请补充订单号。",
      "confirm_text": "请提供正确的订单号。",
      "exhausted_text": "系统暂时不可用，请稍后重试。",
      "explain_text": "无法完成该请求。",
      "expected": {
        "tools": ["get_order", "get_order"],
        "tool_mode": "ordered",
        "answer_contains": ["查询完成"],
        "terminal_state": {"executor_calls": 0}
      }
    },
    {
      "id": "not_found",
      "category": "not_found",
      "message": "帮我查订单 ORD-MISSING",
      "tool": "get_order",
